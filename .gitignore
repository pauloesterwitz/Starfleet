# Swift build output
.build/
*.xcodeproj
*.xcworkspace

# Packaged app bundle -- built by ./package.sh
*.app/

# Python venv for the panel tooling -- recreate with uv (see panel-theme/README.md)
panel-theme/.venv/
__pycache__/
*.pyc

# Third-party reference implementations. Deliberately NOT vendored:
# smartmonitor_hid_lib is GPL-3.0 and this repo is MIT, so committing it here
# would be a licence conflict. panel-theme/README.md has the clone commands.
panel-theme/vendor/

# Generated by build_theme.py on every run
panel-theme/theme_assets/starfleet_bg.bmp

# macOS
.DS_Store

# Machine-local: which theme contract is flashed on THIS panel (written by upload_theme.py)
panel-theme/.flashed-contract.json

# Red Alert's klaxon: fleet.py serves fleet-ui/sounds/tng_red_alert1.mp3 from next to itself. The
# clip is copyrighted, so it is never committed; without it the page plays a synthesized klaxon.
fleet-ui/sounds/
