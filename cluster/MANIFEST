cluster/llama-swap/ctxproxy.py                  ~/llama-swap/ctxproxy.py                       jean-luc
cluster/llama-swap/ctx-env.sh                   ~/llama-swap/ctx-env.sh                        jean-luc
cluster/llama-swap/memcheck.sh                  ~/llama-swap/memcheck.sh                       jean-luc
cluster/llama-swap/render-guard.sh              ~/llama-swap/render-guard.sh                   jean-luc
cluster/llama-swap/reclaim-dflash.sh            ~/llama-swap/reclaim-dflash.sh                 jean-luc
cluster/llama-swap/reap-orphan-sglang.sh        ~/llama-swap/reap-orphan-sglang.sh             jean-luc
cluster/llama-swap/pick-node.sh                 ~/llama-swap/pick-node.sh                      jean-luc
cluster/llama-swap/gpujob-run                   ~/llama-swap/gpujob-run                        jean-luc
cluster/llama-swap/serve-vllm-dflash.sh         ~/llama-swap/serve-vllm-dflash.sh              jean-luc
cluster/llama-swap/serve-starfleet.sh           ~/llama-swap/serve-starfleet.sh                jean-luc
cluster/llama-swap/serve-sglang.sh              ~/llama-swap/serve-sglang.sh                   jean-luc
cluster/llama-swap/serve-nemcascade.sh          ~/llama-swap/serve-nemcascade.sh               jean-luc
cluster/llama-swap/serve-kathryn.sh             ~/llama-swap/serve-kathryn.sh                  jean-luc
cluster/llama-swap/serve-kathryn-nemcascade.sh  ~/llama-swap/serve-kathryn-nemcascade.sh       jean-luc
cluster/llama-swap/serve-embed.sh               ~/llama-swap/serve-embed.sh                    jean-luc
cluster/llama-swap/serve-kathryn-embed.sh       ~/llama-swap/serve-kathryn-embed.sh            jean-luc
cluster/llama-swap/ds4-tp2-proxy-guard.sh       ~/llama-swap/ds4-tp2-proxy-guard.sh            jean-luc
cluster/llama-swap/run-single-node.sh           ~/llama-swap/run-single-node.sh                jean-luc
cluster/llama-swap/run-sglang-tp2-cluster.sh    ~/llama-swap/run-sglang-tp2-cluster.sh         jean-luc
cluster/llama-swap/run-ds4-tp2-cluster.sh       ~/llama-swap/run-ds4-tp2-cluster.sh            jean-luc
cluster/ds4/serve-ds4.sh                        ~/ds4/serve-ds4.sh                             jean-luc

# ---- Jean-Luc -> Kathryn mirror
cluster/kathryn-sync.sh                         ~/.local/bin/kathryn-sync.sh                   jean-luc

# ---- systemd user units (after pushing one: systemctl --user daemon-reload)
cluster/systemd/llama-swap.service              ~/.config/systemd/user/llama-swap.service          jean-luc
cluster/systemd/llama-swap-ctxproxy.service     ~/.config/systemd/user/llama-swap-ctxproxy.service jean-luc
cluster/systemd/fleet-ui.service                ~/.config/systemd/user/fleet-ui.service            jean-luc
cluster/systemd/reap-orphan-sglang.service      ~/.config/systemd/user/reap-orphan-sglang.service  jean-luc
cluster/systemd/reap-orphan-sglang.timer        ~/.config/systemd/user/reap-orphan-sglang.timer    jean-luc
cluster/systemd/kathryn-sync.service            ~/.config/systemd/user/kathryn-sync.service        jean-luc
cluster/systemd/kathryn-sync.timer              ~/.config/systemd/user/kathryn-sync.timer          jean-luc
