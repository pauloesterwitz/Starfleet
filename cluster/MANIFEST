# Files this repo deploys to the cluster:   <repo path>   <host path>   <nodes...>
#
# Deploy and verify with cluster/sync-hosts.sh (check | pull | push).
#
# Jean-Luc is the cluster's source of truth. kathryn-sync.timer mirrors ~/llama-swap
# and ~/ds4 from Jean-Luc to Kathryn hourly with --delete, so those files are listed
# for jean-luc only -- pushing them to Kathryn directly would be overwritten anyway.
# ~/bin is NOT mirrored, hence both nodes for the status tools the app runs over ssh.
#
# The boundary is "everything the running fleet executes": the closure of what
# config.yaml, ctxproxy, fleet.py and the systemd timers invoke. Deliberately not
# tracked: the llama-swap binary, the ~40 bench / retest / diag one-offs, run logs,
# result tables and notes in ~/llama-swap, and obsolete launchers (m3ar, minimax-tp2,
# ollama) that no member uses.

# ---- Fleet UI (served by fleet-ui.service)
fleet-ui/fleet.py                               ~/fleet-ui/fleet.py                            jean-luc
fleet-ui/fleet.html                             ~/fleet-ui/fleet.html                          jean-luc

# ---- status tools the Mac app runs on each node over ssh
cluster/opencode-status.py                      ~/bin/opencode-status.py                       jean-luc kathryn
cluster/opencode-export-tail.py                 ~/bin/opencode-export-tail.py                  jean-luc kathryn

# ---- opencode integration
cluster/opencode-sync-model-limits.py           ~/bin/opencode-sync-model-limits.py            jean-luc
cluster/opencode/merge-system-llamaswap.mjs     ~/.config/opencode/merge-system-llamaswap.mjs  jean-luc

# ---- llama-swap: config, request proxy, and every launcher a member's cmd runs
