#!/bin/bash
# Stands in for apt-get on the made-up host. The simulation prints apt-sim.txt (the test swaps it between steps).
# update takes scan-delay seconds and fails like a lock held by the nightly run while apt-lock exists. The real
# upgrade, which runs inside the unit, follows job.conf: RC (how it ends), DELAY (seconds), PER (lines a second),
# REBOOT (1 leaves a reboot pending), NOTE (a line printed every second); on success apt-sim-after.txt, if there is one, becomes the new apt-sim.txt.
# --no-remove: when the simulation lists a removal (a Remv line), a real upgrade (and a simulation of one) refuses the way
# apt does, exit 100, and changes nothing. Every upgrade that goes through leaves a line in applied.log (with its arguments), so a test can tell
# an upgrade that changed the host from one that was refused.
H=$E2E_HOST
echo "$(date +%s.%N) apt-get $*" >> "$H/calls.log"
case " $* " in
  *" update "*)
    sleep "$(cat "$H/scan-delay" 2>/dev/null || echo 0)"
    if [ -e "$H/apt-lock" ]; then
      echo "E: Could not get lock /var/lib/apt/lists/lock. It is held by process 1234 (unattended-upgr)" >&2
      echo "E: Unable to lock directory /var/lib/apt/lists/" >&2
      exit 100
    fi ;;
  *" -s "*)
    if [[ " $* " == *" --no-remove "* ]] && grep -q '^Remv ' "$H/apt-sim.txt"; then      # apt checks this before it simulates, too
      echo "E: Packages need to be removed but remove is disabled." >&2
      exit 100
    fi
    cat "$H/apt-sim.txt" ;;
  *" full-upgrade "*)
    RC=0 DELAY=3 PER=2 REBOOT=0 NOTE=; . "$H/job.conf" 2>/dev/null
    printf 'Reading package lists...\nCalculating upgrade...\n'
    grep -m1 -E '^[0-9]+ upgraded, [0-9]+ newly installed' "$H/apt-sim.txt"
    if [[ " $* " == *" --no-remove "* ]] && grep -q '^Remv ' "$H/apt-sim.txt"; then
      echo "E: Packages need to be removed but remove is disabled." >&2
      exit 100
    fi
    for ((i = 1; i <= DELAY; i++)); do
      [ -n "$NOTE" ] && echo "$NOTE"
      for ((j = 1; j <= PER; j++)); do echo "Setting up libexample$i-$j:arm64 (1.$i-2) ..."; done
      sleep 1
    done
    if [ "$RC" != 0 ]; then echo "E: Sub-process /usr/bin/dpkg returned an error code (1)"; exit "$RC"; fi
    echo "$(date +%s.%N) applied $*" >> "$H/applied.log"
    [ -e "$H/apt-sim-after.txt" ] && cp "$H/apt-sim-after.txt" "$H/apt-sim.txt"
    if [ "$REBOOT" = 1 ]; then touch "$H/var/run/reboot-required"; printf 'linux-image-6.8.0-99-generic\nlibc6\n' > "$H/var/run/reboot-required.pkgs"; fi
    echo "Processing triggers for libc-bin (2.39-0ubuntu8.12) ..." ;;
  *) exit 1 ;;
esac
