#!/bin/bash
# Stands in for passwordless sudo: runs the command as it is, but only a stand-in of this folder, named without a path. A path such as
# /bin/systemctl would reach the real program, so it is refused.
echo "$(date +%s.%N) sudo $*" >> "$E2E_HOST/calls.log"
[ "$1" = -n ] && shift
[[ $1 != */* && $(command -v "$1") == "$(dirname "$0")/$1" ]] || { echo "sudo: stand-in: $1 is not one of the stand-ins" >&2; exit 1; }
exec "$@"
